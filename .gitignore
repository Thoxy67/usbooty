/target
/rufus
*.img
*.iso

# makepkg build artefacts — generated by `makepkg` inside packaging/,
# they should never be tracked. The source clone, the unpacked build dir
# and the produced package all live here.
/packaging/pkg/
/packaging/src/
/packaging/usbooty/
/packaging/*.pkg.tar.*

# AppImage build artefacts — output AppImage goes to the repo root, the
# linuxdeploy helpers + staged AppDir into target/appimage/ (already
# covered by /target).
/*.AppImage
/packaging/appimage/linuxdeploy*
/packaging/appimage/AppDir/
