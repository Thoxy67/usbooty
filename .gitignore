/target
/rufus
/BCD-SYS
/win
*.img
*.iso

# makepkg build artefacts — generated by `makepkg` inside packaging/,
# they should never be tracked. The source clone, the unpacked build dir
# and the produced package all live here.
/packaging/pkg/
/packaging/src/
/packaging/usbooty/
/packaging/*.pkg.tar.*

# AppImage build artefacts — output AppImage goes to the repo root, the
# linuxdeploy helpers + staged AppDir into target/appimage/ (already
# covered by /target).
/*.AppImage
/packaging/appimage/linuxdeploy*
/packaging/appimage/AppDir/

# Compiled translation binaries — produced by `lrelease6` from the .ts
# sources sitting next to them; reproducible from `update-translations.sh`,
# baked into the binary at build time via crates/gui/qrc/translations.qrc.
# The .ts files themselves stay tracked (translators edit those).
/data/translations/*.qm
# lupdate sometimes leaves backup files around.
/data/translations/*.ts.bak
/data/translations/*.ts~

# qmlls (QML Language Server) per-developer config — usually carries an
# absolute `buildDir` path under target/, so it can't be shared across
# machines. Editors that use qmlls (VS Code QML extension, Qt Creator)
# write it locally and read it for autocomplete / type-checking.
.qmlls.ini
