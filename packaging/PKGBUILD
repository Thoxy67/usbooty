# Maintainer: Thoxy <the.thi67@gmail.com>
pkgname=usbooty-git
_pkgname=usbooty
pkgver=0.1.0.r4.g6fe7f6d
pkgrel=1
pkgdesc="Create bootable USB drives from ISO images — a Rufus-like tool (git version)"
arch=('x86_64' 'aarch64')
url="https://git.thoxy.xyz/thoxy/usbooty"
license=('GPL-3.0-or-later')
depends=(
    'qt6-base'
    'qt6-declarative'
    'polkit'
    # util-linux ships lsblk/losetup/mount/umount/blkid/findmnt — universally
    # present on Arch, but make it explicit since the helper *will* fail
    # without them. (No-op on most installs; keeps `pacman -Rs` honest.)
    'util-linux'
    # libzstd is linked dynamically (see build()); list it explicitly so the
    # transitive dep is visible to `pacman -Rs`. `zstd` is in base anyway.
    'zstd'
)
makedepends=(
    'rust'
    'git'
    'qt6-base'
    'qt6-declarative'
    'pkgconf'
    # libzstd dev headers for zstd-sys's system-libzstd path.
    'zstd'
    # `lrelease6` compiles the .ts translation sources into the .qm files
    # that the qrc embeds; the .qm files are gitignored so they have to be
    # generated at build time.
    'qt6-tools'
)
optdepends=(
    # Filesystem formatters — one per FS the user can pick in the GUI.
    'dosfstools: FAT16/FAT32 formatting (DD-fallback, Ventoy data partition)'
    'ntfs-3g: NTFS formatting (Windows install media, UEFI:NTFS layout, Windows To Go)'
    'exfatprogs: exFAT formatting (cross-platform large-file FS)'
    'e2fsprogs: ext2/ext3/ext4 formatting (Linux persistence overlay)'
    'udftools: UDF formatting'
    'btrfs-progs: Btrfs formatting'
    'xfsprogs: XFS formatting'
    'f2fs-tools: F2FS formatting'
    'jfsutils: JFS formatting'
    'nilfs-utils: NILFS2 formatting'
    # Optional feature backends — usbooty surfaces a banner if these are
    # missing only when the matching feature is selected.
    'ventoy: Ventoy multi-boot USB creation'
    'mtools: FreeDOS bootable USB (mformat / mcopy)'
    'wimlib: split an oversized install.wim onto FAT32'
    'syslinux: BIOS / legacy MBR bootloader install for Linux ISOs on FAT/ext4'
    'libisoburn: xorriso for advanced ISO inspection / repair'
    'qemu-full: boot-test a device in a VM (Device → Verify boot device)'
    'edk2-ovmf: UEFI firmware for the QEMU boot test (BIOS works without it)'
    # Quality-of-life integrations — features degrade silently when absent.
    'smartmontools: SMART health probe + Inspect-dialog SMART panel'
    'udisks2: auto-mount + open of the Ventoy data partition after install'
    'xdg-utils: open the data partition in the user file manager'
    'libnotify: desktop notification when a long job finishes'
)
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Disable LTO: makepkg's `lto` adds -flto only to CXXFLAGS, so cxx-qt-lib's C++
# glue compiles to GCC LTO bitcode that rust-lld cannot resolve at link time
# (undefined `cxxbridge`/`qguiapplication_new` symbols). Rust is not LTO'd to
# match, so the two sides cannot be linked together.
options=('!lto')
source=("$_pkgname::git+https://git.thoxy.xyz/thoxy/usbooty.git")
sha256sums=('SKIP')
install="$pkgname.install"

pkgver() {
    cd "$_pkgname"
    # Last tag plus the commit distance for a sortable version; falls back to
    # a base + commit count when the repo has no tag yet.
    if git describe --long --tags --abbrev=7 >/dev/null 2>&1; then
        git describe --long --tags --abbrev=7 \
            | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "0.1.0.r%s.g%s" \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short=7 HEAD)"
    fi
}

build() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # zstd-sys's vendored static build silently drops its link directive in
    # the makepkg environment (clean chroot or makepkg's RUSTFLAGS/LDFLAGS
    # interfere with the bundled C compile), so the final link fails with
    # `undefined symbol: ZSTD_*`. Force the system libzstd via pkg-config —
    # `zstd` package is in `base`, so it's always present on the user's
    # system anyway, and listed in depends= to make the runtime link
    # explicit. See https://github.com/gyscos/zstd-rs/issues/229
    export ZSTD_SYS_USE_PKG_CONFIG=1

    # Strip every -flto* token from the C/C++ flags. The cc::Build invoked
    # by cxx-qt-build (and by cxx, ring, blake3, etc.) honours CXXFLAGS /
    # CFLAGS straight from the environment. On distros whose makepkg.conf
    # adds `-flto=auto` (CachyOS does), every .cpp / .c is compiled to
    # LLVM bitcode and rust-lld — invoked without LTO since our Rust
    # profile sets `lto = false` — can't read those object files, so the
    # final link reports every cxxbridge / ring symbol as undefined. The
    # PKGBUILD's `options=('!lto')` removes the plain `-flto` token on
    # standard Arch but doesn't always strip `-flto=auto`, so do it
    # ourselves to make the build deterministic everywhere.
    export CXXFLAGS="$(printf '%s\n' $CXXFLAGS | grep -v '^-flto' | tr '\n' ' ')"
    export CFLAGS="$(printf '%s\n' $CFLAGS | grep -v '^-flto' | tr '\n' ' ')"
    export LDFLAGS="$(printf '%s\n' $LDFLAGS | grep -v '^-flto' | tr '\n' ' ')"

    # The .qm translation binaries are gitignored, so a fresh clone
    # won't have them; crates/gui/build.rs auto-runs `lrelease6` (from
    # qt6-tools in makedepends) over every .ts before the qrc embed step.
    cargo build --release --locked
}

check() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export ZSTD_SYS_USE_PKG_CONFIG=1
    # The ISO-analysis tests need `xorriso` and skip themselves when it is
    # absent; every other test is deterministic and hardware-free.
    cargo test --release --locked --workspace
}

package() {
    cd "$_pkgname"

    # The GUI runs unprivileged; the helper is invoked via pkexec and must
    # live at the path pinned in the polkit policy.
    install -Dm755 target/release/usbooty \
        "$pkgdir/usr/bin/usbooty"
    install -Dm755 target/release/usbooty-helper \
        "$pkgdir/usr/libexec/usbooty/usbooty-helper"

    install -Dm644 data/org.usbooty.helper.policy \
        "$pkgdir/usr/share/polkit-1/actions/org.usbooty.helper.policy"
    install -Dm644 data/org.usbooty.Usbooty.desktop \
        "$pkgdir/usr/share/applications/org.usbooty.Usbooty.desktop"
    install -Dm644 data/org.usbooty.Usbooty.metainfo.xml \
        "$pkgdir/usr/share/metainfo/org.usbooty.Usbooty.metainfo.xml"
    install -Dm644 data/icons/org.usbooty.Usbooty.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.usbooty.Usbooty.svg"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
